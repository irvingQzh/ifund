# Copy to a private server-only environment file; never commit real values.
# Nginx strips /qfund/ and proxies to the loopback listener of the private service.
QFUND_PRODUCTION=true
ALLOW_REGISTRATION=false
DB_BACKEND=sqlite
DB_PATH=/var/lib/qfund/data.db
# REQUIRED: generate separately with python3 -c 'import secrets; print(secrets.token_hex(32))'
# Leave blank here deliberately: production refuses to start until replaced.
SECRET_KEY=
# Production default is 1 day; valid range is >0 and <=30 (no everlasting JWT).
JWT_EXPIRES_DAYS=1
# Production always disables arbitrary-PID remote termination and web AI execution.
# Do not place Qoder/API credentials in this public-facing service environment.
